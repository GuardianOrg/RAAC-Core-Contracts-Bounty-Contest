# You can get your Alchemy API key from https://www.alchemy.com/ 
# If not provided, will disable forking 
BASE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/{$ALCHEMY_KEY}
# Mnemonic, this is the hardhat one, if you change it and use the Deployer, review the prepareTGE.js file as you will 
# need to change the wallet "deployer" in the config.js file
MNEMONIC=test test test test test test test test test test test junk

NETWORK=local


# Required for fork to be enabled - will auto-detect when network=local & if fork rpc provided + if has sepolia in name or not
FORK_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/{$ALCHEMY_KEY}
# FORK_CHAIN_ID : to specify specific id to use (for non autodetectable URI)

# 10045000 | Jan-14-2026 on sepolia.
# 24240000 | Jan-15-2026 on mainnet.
FORK_BLOCK_NUMBER=10045000