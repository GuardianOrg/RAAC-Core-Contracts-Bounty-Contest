{
  "name": "@raac/contracts",
  "version": "1.0.0",
  "description": "RAAC V1 Core Contracts",
  "main": "index.js",
  "scripts": {
    "start:all": "docker-compose up --build",
    "test": "npm run test:all",
    "test:all": "npm run test:unit:all && npm run test:e2e:all",
    "test:e2e:all": "npm run test:e2e:collector && npm run test:e2e:lending && npm run test:e2e:pools && npm run test:e2e:gauges && npm run test:e2e:governance && npm run test:e2e:distribution",
    "test:e2e:collector": "npx hardhat test test/e2e/collector-tests.js",
    "test:e2e:lending": "npx hardhat test test/e2e/lending-tests.js",
    "test:e2e:pools": "npx hardhat test test/e2e/pools-transfers-tests.js",
    "test:e2e:gauges": "npx hardhat test test/e2e/gauges-tests.js",
    "test:e2e:governance": "npx hardhat test test/e2e/governance-tests.js",
    "test:e2e:distribution": "npx hardhat test test/e2e/distribution-tests.js",
    "test:unit:all": "bash ./test/run-unit-tests.sh",
    "test:unit:collectors": "npx hardhat test test/unit/core/collectors/*.test.js",
    "test:unit:collectors:fee": "npx hardhat test test/unit/core/collectors/FeeCollector.test.js",
    "test:unit:collectors:nftroyalty": "npx hardhat test test/unit/core/collectors/NFTRoyaltyFeeCollector.test.js",
    "test:unit:governance": "npx hardhat test test/unit/core/governance/*/*.test.js",
    "test:unit:gauges": "npx hardhat test test/unit/core/governance/gauges/*.test.js",
    "test:unit:governance:gauges:RWA": "npx hardhat test test/unit/core/governance/gauges/RWAGauge.test.js",
    "test:unit:governance:gauges:RAAC": "npx hardhat test test/unit/core/governance/gauges/RAACGauge.test.js",
    "test:unit:tokens": "ALLOW_SAME_TIMESTAMP=false npx hardhat test test/unit/core/tokens/*.test.js",
    "test:unit:tokens:debt": "npx hardhat test test/unit/core/tokens/DebtToken.test.js",
    "test:unit:tokens:rtoken": "npx hardhat test test/unit/core/tokens/RToken.test.js",
    "test:unit:tokens:raacnft": "npx hardhat test test/unit/core/tokens/RAACNFT.test.js",
    "test:unit:tokens:veraac": "ALLOW_SAME_TIMESTAMP=false npx hardhat test test/unit/core/tokens/veRAACToken.test.js",
    "test:unit:tokens:stoken": "npx hardhat test test/unit/core/tokens/SToken.test.js",
    "test:unit:zeno": "FORK_RPC_URL= npx hardhat test test/unit/Zeno/Zeno.spec.js",
    "test:unit:minters": "npx hardhat test test/unit/core/minters/*.test.js",
    "test:unit:minters:minter": "npx hardhat test test/unit/core/minters/RAACMinter.test.js",
    "test:unit:minters:orchestrator": "npx hardhat test test/unit/core/minters/RAACReleaseOrchestrator.test.js",
    "test:unit:pools": "npx hardhat test test/unit/core/pools/*/*.test.js",
    "test:unit:pools:lendingpool": "npx hardhat test test/unit/core/pools/LendingPool/*.test.js",
    "test:unit:pools:stabilitypool": "npx hardhat test test/unit/core/pools/StabilityPool/StabilityPool.test.js",
    "test:unit:vaults": "npx hardhat test test/unit/core/vaults/*/*.test.js",
    "test:unit:vaults:rwavault": "npx hardhat test test/unit/core/vaults/RWAVault.test.js",
    "test:unit:raac": "npx hardhat test test/unit/core/tokens/RAACToken.test.js",
    "test:unit:veraac": "ALLOW_SAME_TIMESTAMP=false npx hardhat test test/unit/core/tokens/veRAACToken.test.js",
    "test:unit:libraries": "npx hardhat test test/unit/libraries/*/*.test.js",
    "test:unit:lockers": "npx hardhat test test/unit/core/lockers/*.test.js",
    "test:integration:governance": "npx hardhat test contracts/test/integration/governance.integration.js",
    "test:unit:oracles": "npx hardhat test test/unit/core/oracles/*.test.js",
    "test:burn-in": "./test/run-burn-in-tests.sh",
    "test:unit:primitives:compliance": "npx hardhat test test/unit/core/primitives/ComplianceRegistry.test.js",
    "test:unit:primitives:raachouseprices": "npx hardhat test test/unit/core/primitives/RAACHousePrices.test.js",
    "serve:docs": "npx docsify-cli serve ./docs",
    "compile": "npx hardhat compile",
    "node": "npx hardhat node --hostname 0.0.0.0",
    "deploy": "node --env-file=./library/Deployer/.env ./library/Deployer/execute_deployment.js --logs | tee dump_deploy_$(date +%Y%m%d_%H%M%S).log",
    "dev:local": "npx --node-arg=--require=dotenv/config hardhat run scripts/deploy_devnet.js --network localhost --show-stack-traces",
    "dev:full": "node scripts/dev-full.js",
    "deploy:blender:sepolia": "npx hardhat run deployment/rwaf/deploy_blender_sepolia.js --network sepolia",
    "deploy:blender:mainnet": "npx hardhat run deployment/rwaf/deploy_blender_mainnet.js",
    "deploy:compliance-registry:mainnet": "npx hardhat run deployment/compliance-registry/compliance_registry_mainnet.js",
    "deploy:minter:local": "npx hardhat run deployment/minter/deploy_minter_local.js --network localhost",
    "deploy:minter:mainnet": "npx hardhat run deployment/minter/deploy_minter_mainnet.js",
    "aws:verify": "npx hardhat run deployment/verify-aws.js",
    "aws:sign": "npx hardhat run deployment/sign-aws.js",
    "deploy:gauge-controller:raac:local": "GAUGES_SYSTEM=raac npx hardhat run deployment/gauges/deploy_controller_local.js --network localhost",
    "deploy:gauge-controller:raac:sepolia": "GAUGES_SYSTEM=raac npx hardhat run deployment/gauges/deploy_controller_sepolia.js --network sepolia",
    "deploy:gauge-controller:raac:mainnet": "GAUGES_SYSTEM=raac npx hardhat run deployment/gauges/deploy_controller_mainnet.js",
    "deploy:gauge-controller:rwa:local": "GAUGES_SYSTEM=rwa npx hardhat run deployment/gauges/deploy_controller_local.js --network localhost",
    "deploy:gauge-controller:rwa:sepolia": "GAUGES_SYSTEM=rwa npx hardhat run deployment/gauges/deploy_controller_sepolia.js --network sepolia",
    "deploy:gauge-controller:rwa:mainnet": "GAUGES_SYSTEM=rwa npx hardhat run deployment/gauges/deploy_controller_mainnet.js",
    "deploy:gauges:raac:local": "GAUGES_SYSTEM=raac npx hardhat run deployment/gauges/deploy_gauges_local.js --network localhost",
    "deploy:gauges:raac:sepolia": "GAUGES_SYSTEM=raac npx hardhat run deployment/gauges/deploy_gauges_sepolia.js --network sepolia",
    "deploy:gauges:raac:mainnet": "GAUGES_SYSTEM=raac npx hardhat run deployment/gauges/deploy_gauges_mainnet.js",
    "deploy:gauges:rwa:local": "GAUGES_SYSTEM=rwa npx hardhat run deployment/gauges/deploy_gauges_local.js --network localhost",
    "deploy:gauges:rwa:sepolia": "GAUGES_SYSTEM=rwa npx hardhat run deployment/gauges/deploy_gauges_sepolia.js --network sepolia",
    "deploy:gauges:rwa:mainnet": "GAUGES_SYSTEM=rwa npx hardhat run deployment/gauges/deploy_gauges_mainnet.js",
    "deploy:lockers:local": "npx hardhat run deployment/lockers/deploy_lockers_local.js --network localhost",
    "seed:lockers:local": "npx hardhat run deployment/lockers/seed_local.js --network localhost",
    "setup:lockers:local": "npm run deploy:lockers:local && npm run seed:lockers:local"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RegnumAurumAcquisitionCorp/core.git"
  },
  "keywords": [
    "RAAC",
    "Regnum Aurum Acquisition Corp",
    "ethereum",
    "v1",
    "core",
    "protocol",
    "solidity"
  ],
  "author": "RAAC Protocol Team",
  "license": "BSL-1.1",
  "bugs": {
    "url": "https://github.com/RegnumAurumAcquisitionCorp/core/issues"
  },
  "homepage": "https://github.com/RegnumAurumAcquisitionCorp/core#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.6",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomiclabs/hardhat-etherscan": "^3.1.8",
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/contracts-upgradeable": "^5.0.2",
    "@openzeppelin/contracts-upgradeable-v3": "npm:@openzeppelin/contracts-upgradeable@^3.4.1-solc-0.7-2",
    "@openzeppelin/contracts-v3": "npm:@openzeppelin/contracts@^3.4.1-solc-0.7-2",
    "@openzeppelin/hardhat-upgrades": "^3.2.0",
    "chai": "^4.5.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "hardhat": "^2.22.14",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^2.3.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.896.0",
    "@chainlink/contracts": "^1.3.0",
    "@chainlink/env-enc": "^1.0.5",
    "@chainlink/functions-toolkit": "^0.3.2",
    "@prb/math": "^4.0.3",
    "@raac/aws-kms-connectors": "^1.0.2",
    "erc721a": "^4.3.0",
    "solmate": "^6.2.0",
    "strip-ansi": "^7.1.0"
  }
}
